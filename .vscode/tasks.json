{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake Build",
            "command": "cmake",
            "args": [
                "--preset",
                "default"
            ],
            "group": "none"
        },
        {
            "type": "shell",
            "label": "CMake Compile",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "default"
            ],
            "dependsOn": [
                "CMake Build"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
